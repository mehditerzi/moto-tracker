PORT=8787
NODE_ENV=development
DATABASE_PATH=./data/app.db

# Local dev: Vite serves the frontend at :5173 and proxies /api to :8787.
APP_BASE_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173

# In dev WEB_ROOT is unset — Vite handles the UI. In Docker compose the
# image sets WEB_ROOT=/app/public so Express serves the built React.
# WEB_ROOT=

# Trust proxy headers (X-Forwarded-Proto, etc.) from ngrok/Cloudflare. Leave
# false locally; the Docker image enables this.
TRUST_PROXY=false

SESSION_SECRET=replace-me-with-32-chars-of-random
RESEND_API_KEY=
EMAIL_FROM="Garajım <noreply@example.com>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OCR
UPLOADS_DIR=./data/uploads
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=gemma4:26b
# Text-only model for parsing Tesseract output (faster than vision — try gemma4:e2b)
OLLAMA_PARSE_MODEL=
OCR_AUTO_APPLY_THRESHOLD=0.7
# Max documents OCR'd in parallel across users (per-user is always serial).
OCR_CONCURRENCY=2

# Dev-only: enriches the bundled make/model catalog when you run
# `node scripts/fetch-moto-catalog.mjs`. Not read at runtime.
API_NINJAS_KEY=

# Web Push (run: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@mototracker.app
CRON_TIMEZONE=Europe/Istanbul
CRON_HOUR=9
CRON_ENABLED=true
