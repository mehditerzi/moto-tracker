PORT=8787
NODE_ENV=development
DATABASE_PATH=./data/app.db
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-me-with-32-chars-of-random
RESEND_API_KEY=
EMAIL_FROM="MotoTracker <noreply@example.com>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
