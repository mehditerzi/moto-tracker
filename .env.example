# ============================================================================
# MotoTracker — Docker compose env (root)
# ============================================================================
# Copy to `.env` and fill in. The bootstrap script (scripts/bootstrap.sh) will
# generate or prompt for everything required.

# --- Tunnel: Cloudflare (production) ----------------------------------------
# Production is fronted by Cloudflare Tunnel. Create a tunnel in the Cloudflare
# Zero Trust dashboard, point its ingress at http://api:8787, and paste the
# connector token here. When set, bootstrap.sh uses Cloudflare and skips ngrok.
# Run the connector with:  docker compose --profile cloudflare up -d
# (or run cloudflared separately on the host).
CLOUDFLARED_TOKEN=

# --- Public origin (required) -----------------------------------------------
# The full public URL the app is reachable at, e.g.
# https://mototracker.mehditerzi.com  (the Cloudflare tunnel hostname).
APP_BASE_URL=

# --- ngrok (legacy / optional) ----------------------------------------------
# Only used if CLOUDFLARED_TOKEN is empty. Start with `--profile ngrok`.
# Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional reserved domain (https://dashboard.ngrok.com/domains). If unset,
# ngrok hands out an ephemeral URL on every restart.
NGROK_DOMAIN=

# --- Session / auth ---------------------------------------------------------
# 32+ random characters. The bootstrap script generates this for you.
SESSION_SECRET=

# --- iOS (Capacitor) wrapper — leave unset for the web deploy ---------------
# Only set these when shipping the native iOS app, whose WebView calls the API
# cross-origin from capacitor://localhost:
#   WEB_ORIGIN=capacitor://localhost   # adds it to CORS + auth trusted origins
#   CROSS_SITE_COOKIES=true            # session cookie as SameSite=None; Secure
WEB_ORIGIN=
CROSS_SITE_COOKIES=false

# Email. Resend is used in production. When RESEND_API_KEY is empty, the API
# falls back to SMTP (below) if SMTP_HOST is set, otherwise it just console.logs
# the link.
RESEND_API_KEY=
EMAIL_FROM="Garajım <noreply@example.com>"
# Local SMTP fallback for dev — point at Mailpit to actually receive
# magic-link / password-reset mail without an external service:
#   docker compose --profile mail up -d      # starts Mailpit
#   inbox UI: http://localhost:8025
# Use SMTP_HOST=localhost for host `pnpm dev:api`, or SMTP_HOST=mailpit when the
# api itself runs inside the compose network.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (optional). APPLE_CLIENT_ID = the Service ID; APPLE_CLIENT_
# SECRET = the ES256 client-secret JWT generated from your .p8 key (max 6-month
# expiry — regenerate before it lapses). Both set → an Apple button appears on
# the sign-in screen. See docs/apple-signin.md.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- OCR --------------------------------------------------------------------
# Four stages, cheapest first. Every value below was chosen from a measured
# eval over real documents — see docs/ocr.md for the numbers, and
# `pnpm --filter @mototracker/api ocr:eval` to re-run it after any change.
#
# ALWAYS PIN THE TAG. An untagged name (`gemma4`) follows whatever :latest
# points at; the API normalises it to `gemma4:latest` and warns at boot.
OLLAMA_URL=http://ollama:11434

# STAGE 1 — image → text. Purpose-built OCR model: reads the plate on 25/25 and
# the inspection date on 23/23 of the corpus in ~3.7s. Tesseract backs it up
# (needs the tesseract-ocr-tur language pack, which the Docker image installs).
OLLAMA_OCR_MODEL=glm-ocr:latest

# STAGE 2 — text → JSON. Runs on EVERY document, so its latency is the user's
# latency. gemma4:e2b measured most accurate AND fastest of the installed
# models (97.1% on the fields it is responsible for, p50 4.5s); gemma4:26b was
# both worse and slower at 18GB.
OLLAMA_PARSE_MODEL=gemma4:e2b

# STAGE 4 — image → JSON in one shot, ONLY for photos stage 1 could not read at
# all. Must be a vision-capable model: the API checks /api/show and skips the
# stage rather than burning the timeout on a model that cannot see. Measured on
# an unreadable-crop case: gemma4:e4b read the plate in 13s; qwen3.6:35b-mlx did
# not finish inside 120s; glm-ocr cannot follow a JSON schema (it is stage 1).
OLLAMA_VISION_MODEL=gemma4:e4b

# STAGE 3 — second opinion on genuinely ambiguous documents. UNSET ON PURPOSE:
# on the production corpus this stage never fired once, so a large model here
# costs ~22GB resident (evicting the models that do the work) and buys nothing.
# Set it only if your documents are harder — and raise OCR_TIMEOUT_MS if you do.
OLLAMA_VERIFY_MODEL=

OCR_AUTO_APPLY_THRESHOLD=0.7
# A backstop, not a budget: p50 is ~9s and p90 ~15s on the measured pipeline.
OCR_TIMEOUT_MS=120000
# Max documents OCR'd in parallel across users (per-user is always serial, and a
# lone interactive scan preempts queued bulk work). The ceiling here is Ollama's
# memory, not CPU — raising it past the point where models start being evicted
# and reloaded makes a bulk batch slower, not faster. Re-measure with
# `ocr:eval -- throughput` if you change the models. See docs/ocr.md.
OCR_CONCURRENCY=2

# --- MapKit JS (trip route maps) --------------------------------------------
# Developer portal → Keys → create a key with "MapKit JS" enabled; paste the
# .p8 contents (PEM or base64). Team id falls back to APNS_TEAM_ID when unset.
# All empty → maps stay hidden in the app.
MAPKIT_KEY=
MAPKIT_KEY_ID=
MAPKIT_TEAM_ID=
MAPKIT_MAPS_ID=

# --- Web Push (the bootstrap script generates these) ------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@mototracker.app

# --- Native push (APNs) for the iOS app -------------------------------------
# Web Push does NOT work in the iOS WebView; the native app uses APNs instead.
# Push stays OFF until all four of KEY/KEY_ID/TEAM_ID/BUNDLE_ID are set.
# See docs/app-store/native-push.md for the full setup.
APNS_KEY=               # .p8 contents (PEM) or its base64: `base64 -i AuthKey_XXXX.p8`
APNS_KEY_ID=            # 10-char Key ID from the Apple key
APNS_TEAM_ID=           # 10-char Apple Team ID
APNS_BUNDLE_ID=com.mehditerzi.mototracker
APNS_PRODUCTION=true    # set false when testing against a dev (debug) build

# --- In-app purchases (extra-vehicle subscriptions) -------------------------
# First vehicle free; more require an auto-renewable App Store subscription.
# Verification is offline (JWS vs Apple root CAs in apps/api/certs/apple/).
# Stays OFF (endpoints return 503) until a bundle id resolves + root CAs exist.
# See docs/ios-iap.md.
IAP_APP_APPLE_ID=       # numeric App Store app id; REQUIRED to verify production notifications
# IAP_BUNDLE_ID=        # defaults to APNS_BUNDLE_ID — set only if different
# IAP_APPLE_ROOT_CA_DIR=./certs/apple   # default location of Apple root .cer files
# IAP_ENABLE_ONLINE_CHECKS=false        # true = OCSP revocation checks (needs outbound net)

# --- Cron (daily reminders) -------------------------------------------------
CRON_TIMEZONE=Europe/Istanbul
CRON_HOUR=9
CRON_ENABLED=true
