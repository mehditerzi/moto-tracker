# Public origin of the React PWA (Vercel)
WEB_ORIGIN=https://mototracker.vercel.app
# Base URL of the self-hosted API (your tunnel domain)
APP_BASE_URL=https://api.mototracker.example.com
# Random 32+ char string
SESSION_SECRET=
# BetterAuth secret (32+ random chars)
BETTER_AUTH_SECRET=

# Email (optional, for magic links — falls back to console log if absent)
RESEND_API_KEY=
EMAIL_FROM="MotoTracker <noreply@example.com>"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Tunnel token (from `cloudflared tunnel token <name>`)
CLOUDFLARED_TOKEN=

# OCR (defaults are fine for the docker-compose stack)
OLLAMA_URL=http://ollama:11434
OLLAMA_VISION_MODEL=gemma4
OCR_AUTO_APPLY_THRESHOLD=0.7

# Web Push (run: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@mototracker.app
CRON_TIMEZONE=Europe/Istanbul
CRON_HOUR=9
CRON_ENABLED=true
