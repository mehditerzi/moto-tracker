# ============================================================================
# MotoTracker — Docker compose env (root)
# ============================================================================
# Copy to `.env` and fill in. The bootstrap script (scripts/bootstrap.sh) will
# generate or prompt for everything required.

# --- ngrok (required) -------------------------------------------------------
# Get your authtoken at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional: a reserved domain (free static subdomain at
# https://dashboard.ngrok.com/domains, e.g. "honest-tarpon-44.ngrok-free.app").
# If unset, ngrok hands out an ephemeral URL on every restart.
NGROK_DOMAIN=

# --- Public origin (required) -----------------------------------------------
# The full URL your app is reachable at. Usually `https://<NGROK_DOMAIN>`.
APP_BASE_URL=

# --- Session / auth ---------------------------------------------------------
# 32+ random characters. The bootstrap script generates this for you.
SESSION_SECRET=

# --- iOS (Capacitor) wrapper — leave unset for the web deploy ---------------
# Only set these when shipping the native iOS app, whose WebView calls the API
# cross-origin from capacitor://localhost:
#   WEB_ORIGIN=capacitor://localhost   # adds it to CORS + auth trusted origins
#   CROSS_SITE_COOKIES=true            # session cookie as SameSite=None; Secure
WEB_ORIGIN=
CROSS_SITE_COOKIES=false

# Email (optional — magic links fall back to console log when unset)
RESEND_API_KEY=
EMAIL_FROM="MotoTracker <noreply@example.com>"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OCR --------------------------------------------------------------------
OLLAMA_URL=http://ollama:11434
OLLAMA_VISION_MODEL=gemma4:26b
# Text-only model for parsing Tesseract output (faster than vision — try gemma4:e2b)
OLLAMA_PARSE_MODEL=
OCR_AUTO_APPLY_THRESHOLD=0.7

# --- Web Push (the bootstrap script generates these) ------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@mototracker.app

# --- Cron (daily reminders) -------------------------------------------------
CRON_TIMEZONE=Europe/Istanbul
CRON_HOUR=9
CRON_ENABLED=true
