{
  "name": "mototracker",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r --parallel run build",
    "dev:api": "pnpm --filter @mototracker/api dev",
    "dev:web": "pnpm --filter @mototracker/web dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "moto:catalog": "node scripts/fetch-moto-catalog.mjs",
    "fleet": "node scripts/fleet-admin.mjs",
    "fleet:demo": "node scripts/seed-demo-fleet.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
